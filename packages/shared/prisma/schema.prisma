// Postgres system of record for uploaded videos, multipart sessions,
// async enrichment jobs, derived thumbnails, and share codes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum UploadSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum MediaJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum MediaJobType {
  GenerateThumbnails
  GenerateTitle
}

model Video {
  id         String      @id @default(cuid())
  status     VideoStatus
  title      String?
  durationMs Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  uploadSessions UploadSession[]
  mediaJobs      MediaJob[]
  thumbnails     Thumbnail[]
  shortLinks     ShortLink[]
}

model UploadSession {
  id          String              @id @default(cuid())
  /// Opaque token for /uploads/{token} paths — not the Video id.
  uploadToken String              @unique
  videoId     String
  status      UploadSessionStatus
  /// Multipart upload id from object storage.
  uploadId    String
  objectKey   String
  partSize    Int
  /// Set on abort (e.g. TTL); Video stays UPLOADING.
  abortReason String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
}

model MediaJob {
  id            String         @id @default(cuid())
  videoId       String
  type          MediaJobType
  status        MediaJobStatus
  failureReason String?
  /// Retriable attempts consumed; fails after 3.
  attemptCount  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status])
}

model Thumbnail {
  id          String   @id @default(cuid())
  videoId     String
  /// 0–2; frames at 10% / 50% / 90% of duration.
  ordinal     Int
  objectKey   String
  contentType String
  positionPct Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, ordinal])
}

/// Share identity is the 8-char code itself (not VideoId); many per Video.
model ShortLink {
  code      String   @id
  videoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}
