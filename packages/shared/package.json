{
  "name": "@linkmovie/shared",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate --schema prisma && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "prisma:generate": "prisma generate --schema prisma",
    "prisma:validate": "prisma validate --schema prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma"
  },
  "prisma": {
    "schema": "prisma"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@prisma/client": "^6.19.3"
  }
}
