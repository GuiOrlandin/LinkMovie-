# Compose / local study stack (copy to .env). Study credentials only — not for production.

POSTGRES_USER=linkmovie
POSTGRES_PASSWORD=linkmovie
POSTGRES_DB=linkmovie

# Host-side Prisma / apps talking to published ports
DATABASE_URL=postgresql://linkmovie:linkmovie@localhost:5432/linkmovie?schema=public

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=linkmovie
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

RABBITMQ_DEFAULT_USER=linkmovie
RABBITMQ_DEFAULT_PASS=linkmovie
RABBITMQ_URL=amqp://linkmovie:linkmovie@localhost:5672

# Used by api/worker/web when profile `apps` is enabled
APP_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
